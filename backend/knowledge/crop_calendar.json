  {"crop": "小麦", "month": 4, "stage": "抽穗扬花", "advice": "4月抽穗扬花期防赤霉病（见花打药）、防蚜虫。"},
  {"crop": "小麦", "month": 5, "stage": "灌浆收获", "advice": "5月灌浆期防干热风，叶面喷磷酸二氢钾，适时收获。"},

  {"crop": "玉米", "month": 4, "stage": "播种", "advice": "4月春播，施足底肥，合理密植，防地下害虫。"},
  {"crop": "玉米", "month": 6, "stage": "大喇叭口", "advice": "6月大喇叭口期追穗肥，丢心防玉米螟，中耕培土。"},
  {"crop": "玉米", "month": 8, "stage": "灌浆收获", "advice": "8月灌浆期防旱排涝，适时晚收促增重。"},

  {"crop": "番茄", "month": 3, "stage": "育苗定植", "advice": "3月育苗，4月定植，施足有机肥，地膜覆盖。"},
  {"crop": "番茄", "month": 5, "stage": "开花结果", "advice": "5月开花结果期防晚疫病、灰霉病，及时整枝打杈。"},
  {"crop": "番茄", "month": 6, "stage": "盛果期", "advice": "6月盛果期勤追肥水，防裂果、防日灼，适时采收。"},

  {"crop": "黄瓜", "month": 3, "stage": "育苗定植", "advice": "3月育苗，4月定植大棚，施足基肥，搭架引蔓。"},
  {"crop": "黄瓜", "month": 5, "stage": "结瓜期", "advice": "5月结瓜期防霜霉病、白粉病，勤追肥水，及时采收。"},

  {"crop": "苹果", "month": 3, "stage": "萌芽期", "advice": "3月萌芽前清园喷石硫合剂，刮老皮，防越冬病虫。"},
  {"crop": "苹果", "month": 4, "stage": "花前花后", "advice": "4月花前花后防蚜虫、红蜘蛛、黑星病，疏花疏果。"},
  {"crop": "苹果", "month": 9, "stage": "采收秋施基肥", "advice": "9月适时采收，秋施基肥（有机肥为主），清园。"},

  {"crop": "柑橘", "month": 3, "stage": "春梢萌发", "advice": "3月春梢萌发期防溃疡病、红蜘蛛，施春肥促梢。"},
  {"crop": "柑橘", "month": 7, "stage": "果实膨大", "advice": "7月果实膨大期防潜叶蛾、锈壁虱，追壮果肥。"},
