  {"crop": "水稻", "month": 3, "stage": "育秧", "advice": "3月育秧，选种消毒，秧田施足底肥，注意防倒春寒。"},
  {"crop": "水稻", "month": 5, "stage": "插秧分蘖", "advice": "5月插秧，浅水促分蘖，分蘖末期晒田控苗，追施分蘖肥。"},
