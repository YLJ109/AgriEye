# 复制为 .env 后按需填写（cp .env.example .env）
# .env 已被 .gitignore 排除，不会进入版本库

# ---------- 认证（SEC-002/006）----------
# JWT 签名密钥。留空时程序自动生成并保存到 backend/data/.secret_key（该文件同样已忽略）。
# 多实例部署或希望重启后旧令牌立即失效时，在此显式配置一个足够长的随机串。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
AGRIEYE_SECRET_KEY=

# ---------- AI 顾问（SEC-005）----------
# 智谱 GLM 的 API Key。配置后浏览器侧无需再填 Key，也不用把明文存进 localStorage。
# 前端仍可在「API 配置」里单独填写，优先级：请求体 > 本环境变量。
ZHIPU_API_KEY=

# ---------- 服务 ----------
# 调试模式：开启后异常响应会回显错误细节（默认关闭，见 SEC-009）
DEBUG=false

# 前端地址白名单（JSON 数组）。默认已含 5188/5173
# CORS_ORIGINS=["http://localhost:5188","http://127.0.0.1:5188"]

# ---------- 推理（ARCH-001，一般无需改动）----------
# 域检查门：模型之前先判断「像不像农作物」，防止无关图片被高置信度误检
# DOMAIN_GATE_ENABLED=true
# DOMAIN_GATE_GREEN_MIN=0.05
# DOMAIN_GATE_YELLOW_MIN=0.6
# DOMAIN_GATE_EDGE_MAX=0.08
