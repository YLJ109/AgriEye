# ===== 依赖与构建产物 =====
node_modules/
dist/
frontend/dist/
# Vite 配置重载时生成的临时文件（vite.config.js.timestamp-*.mjs）
vite.config.js.timestamp-*
.venv/
venv/
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ===== 模型权重（226MB，GitHub 单文件上限 100MB，不放仓库；见 README「获取模型」）=====
backend/data/models/*.onnx
backend/data/models/*.pt
backend/data/models/*.pth

# ===== 运行时数据 =====
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/*.db
backend/data/*.db.bak
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/vector_db/
backend/data/agri.db-journal
# 预览模式产生的临时图片（DATA-003：24h 后自动清理）
backend/data/preview_tmp/
*.bak
# 无障碍扫描工具的浏览器会话残留
.playwright-cli/

# ===== 环境变量与密钥 =====
# 注意：.gitignore 不支持行尾注释，`pattern # 说明` 会把整行当成文件名，规则永远不会命中
.env
.env.local
# JWT 签名密钥，程序自动生成，绝不入库
backend/data/.secret_key

# ===== 编辑器 / IDE / 工具目录 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
.arts/
.codeartsdoer/
.workbuddy/

# ===== 日志 =====
*.log
